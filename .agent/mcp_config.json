{
    "mcpServers": {
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp",
                "--api-key",
                "YOUR_API_KEY"
            ]
        },
        "shadcn": {
            "command": "npx",
            "args": [
                "shadcn@latest",
                "mcp"
            ]
        },
        "supabase-polis": {
            "type": "http",
            "serverURL": "https://mcp.supabase.com/mcp?project_ref=oyzebaxjalhhttjlqdpk",
            "headers": {
                "Authorization": "Bearer YOUR_PERSONAL_ACCESS_TOKEN"
            },
            "disabled": false
        }
    }
}

// setup mcp server in  ~/.gemini\ag-kit\mcp_config.json

